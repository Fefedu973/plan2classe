{
  "name": "plan2classe-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.4",
      "libsql": "0.5.29",
      "hono": "^4.13.16",
      "@orpc/server": "^1.16.1",
      "@orpc/openapi": "^1.16.1",
      "@orpc/zod": "^1.16.1",
      "better-auth": "1.7.15",
      "lucide-react": "^1.66.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.16.1",
      "@tailwindcss/postcss": "^4.3.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && bunx tsc --project scripts/tsconfig.json --noEmit",
    "test": "bun test packages/auth/tests packages/api/tests apps/server/tests",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @plan2classe-app/db --",
    "db:studio": "turbo run db:studio -F @plan2classe-app/db --",
    "db:generate": "turbo run db:generate -F @plan2classe-app/db --",
    "db:migrate": "bun run --cwd packages/db db:migrate:deploy",
    "db:local": "turbo run db:local -F @plan2classe-app/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "demo:account": "cd apps/server && bun ../../scripts/demo-account.ts"
  },
  "dependencies": {
    "@plan2classe-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plan2classe-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "minimatch": "11.0.4",
    "@hono/node-server": "2.1.6",
    "esbuild": "0.28.2"
  }
}
