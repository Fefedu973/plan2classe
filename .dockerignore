# Dependency and build caches
**/node_modules
**/.turbo
**/.next
**/dist
**/build
**/.output
**/.cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]

# VCS, editors and CI metadata are not needed in runtime images
.git
.github
.idea
.vscode
*.log
*.swp

# Local databases, coverage and generated artefacts
.data
**/local.db
**/local.db-*
**/*.sqlite
**/*.sqlite3
**/coverage
**/.coverage
**/htmlcov

# Never copy local secrets into an image layer. Public build-time values are
# injected explicitly as Docker build arguments by Compose.
**/.env
**/.env.*
!**/.env.example

# Deployment and contributor-only files
compose*.yml
docker-compose*.yml
docs
README.md
